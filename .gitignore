# Build output
/dist/

# Local developer automation
/Makefile
*~

# Bundle-size report output (npm run size-report) — a CI artifact, not committed
/bundle-report/

# Test / coverage
/coverage/
/test-results/
/playwright-report/

# Dependencies (restore the committed lock with `npm ci`)
# No trailing slash so a `node_modules` symlink is ignored too.
/node_modules

# Rendered, secret-bearing config — only the *.tmpl is committed
/deploy/config.json
/deploy/client.json

# Reference material (the verbatim deployed SPA, kept locally for diffing)
/reference/

# Project wiki — a separate GitHub repo.wiki.git checkout, not part of this repo
/.wiki/

# impeccable design skill — vendored dev tool + its local state; kept local, not in the repo
/skills/impeccable/
/.impeccable/

# .claude/skills, .codex/skills, .agents/skills are symlinks to /skills/ (checked in, see /skills/)

# OS / editor
.DS_Store
*.log
.idea/
.vscode/

# Python bytecode cache
__pycache__/
*.pyc
